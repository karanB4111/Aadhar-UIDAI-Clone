# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
#
# Tier 3 runs two regional stacks in one apply. Each region's ECR repo ARN
# and URL come from infra/global/ecr; the image_tag must exist in BOTH
# regions before applying (replication ~30 min, ARCHITECTURE.md 5.1.3).

# Mumbai (source) repo.
ecr_repository_arn_mumbai = "arn:aws:ecr:ap-south-1:REPLACE_ACCOUNT_ID:repository/aadhaar-mock"
ecr_repository_url_mumbai = "REPLACE_ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/aadhaar-mock"

# Hyderabad (replica) repo.
ecr_repository_arn_hyderabad = "arn:aws:ecr:ap-south-2:REPLACE_ACCOUNT_ID:repository/aadhaar-mock"
ecr_repository_url_hyderabad = "REPLACE_ACCOUNT_ID.dkr.ecr.ap-south-2.amazonaws.com/aadhaar-mock"

# Short git SHA of the service image pushed to ECR. Must exist in both
# regions. Check with:
#   aws ecr describe-images --region ap-south-1 --repository-name aadhaar-mock
#   aws ecr describe-images --region ap-south-2 --repository-name aadhaar-mock
image_tag = "6cc656f"

# Optional: email for CloudWatch alarm notifications in both regions.
alarm_email = ""
