# Overrides for E1b (ARCHITECTURE.md 8.4): same stack as E1/E2, but with the
# ALB health check at AWS defaults so the error window falls in the predicted
# 30-60 s band instead of the 5-10 s band.
#
# Usage:
#   terraform apply -var-file=terraform.tfvars -var-file=terraform.tfvars.e1b
#
# Copy to terraform.tfvars.e1b (git-ignored) alongside terraform.tfvars.

hc_interval            = 30
hc_timeout             = 5
hc_healthy_threshold   = 5
hc_unhealthy_threshold = 2
